# Loads the devenv flake shell through nix-direnv after an explicit `direnv allow`.
if ! has nix_direnv_version || ! nix_direnv_version 3.0.0; then
  log_error "nix-direnv >= 3.0.0 is required; install it on this host (Pal does not)."
  exit 1
fi
watch_file flake.nix flake.lock devenv.nix
use flake . --no-pure-eval
